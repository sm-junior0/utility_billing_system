        {
          "name": "Send Existing Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{financeToken}}" }
            ],
            "url": "{{baseUrl}}/api/notifications/{{customerApprovalNotificationId}}/send"
          }
        },
        {
          "name": "Send Payment Completed Notification For Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{financeToken}}" }
            ],
            "url": "{{baseUrl}}/api/notifications/bill/{{billId}}/send-payment-completed"
          }
        }
      ]
    },
    {
      "name": "11 - Legacy Prepaid Support",
      "item": [
        {
          "name": "Electricity Prepaid Top-Up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{financeToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meterId\": {{electricityMeterId}},\n  \"amount\": 2000,\n  \"paymentMethod\": \"MOBILE_MONEY\",\n  \"transactionDate\": \"2026-06-05\"\n}"
            },
            "url": "{{baseUrl}}/api/prepaid/topup"
          }
        },
        {
          "name": "List Prepaid Transactions By Customer",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/api/prepaid/customer/{{customerId}}"
          }
        }
      ]
    }
  ]
}
